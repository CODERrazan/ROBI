DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
LLAMA_MODEL_ID=meta-llama/Llama-4-Scout-17B-16E-Instruct
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_VISION_TIMEOUT_SECONDS=150
DATABASE_URL=
ROBI_LAUNCH_SECRET=
ROBI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Priority is 1.5x standard rates; standard-tier Scout requests timed out in live checks.
DEEPINFRA_SERVICE_TIER=priority
VISION_PROVIDER=deepinfra
VISION_MODEL_ID=google/gemma-4-26B-A4B-it

# Cloud per-image timeout; failed candidates are excluded.
DEEPINFRA_VISION_TIMEOUT_SECONDS=15
